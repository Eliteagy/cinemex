  "relight": { "label": "Reiluminar", "group": "efeitos", "inputs": ["imagem"], "params": { "angle": { "label": "Direção da luz (graus)", "type": "number", "min": -180, "max": 180, "step": 1, "default": 135 }, "elevation": { "label": "Altura da luz (graus)", "type": "number", "min": 0, "max": 90, "step": 1, "default": 45 }, "intensity": { "label": "Intensidade", "type": "number", "min": 0, "max": 2, "step": 0.01, "default": 0.4 }, "ambient": { "label": "Luz ambiente", "type": "number", "min": 0, "max": 1, "step": 0.01, "default": 0.2 }, "softness": { "label": "Suavidade", "type": "number", "min": 0, "max": 100, "step": 1, "default": 50 }, "warmth": { "label": "Calor", "type": "number", "min": -1, "max": 1, "step": 0.01, "default": 0 }, "amount": { "label": "Quantidade", "type": "number", "min": 0, "max": 1, "step": 0.01, "default": 1 } } }
