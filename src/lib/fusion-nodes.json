{
  "_comment": "Nós da página Fusion, partilhados pela pré-visualização (src/engine/fusion.ts) e pela exportação (electron/render.cjs fusionChain). inputs: nomes das entradas, por ordem.",
  "mediaIn": { "label": "Entrada (clip)", "group": "io", "inputs": [], "params": {} },
  "mediaOut": { "label": "Saída", "group": "io", "inputs": ["imagem"], "params": {} },
  "media": { "label": "Média", "group": "gerar", "inputs": [], "params": { "mediaId": { "label": "Média", "type": "media", "default": "" } } },
  "background": { "label": "Fundo", "group": "gerar", "inputs": [], "params": { "color": { "label": "Cor", "type": "color", "default": "#101010" } } },
  "merge": { "label": "Juntar", "group": "compor", "inputs": ["fundo", "frente"], "params": { "mode": { "label": "Modo", "type": "select", "options": { "normal": "Normal", "screen": "Ecrã", "multiply": "Multiplicar", "add": "Somar" }, "default": "normal" }, "opacity": { "label": "Opacidade", "type": "number", "min": 0, "max": 1, "step": 0.01, "default": 1 } } },
  "transform": { "label": "Transformar", "group": "compor", "inputs": ["imagem"], "params": { "x": { "label": "Posição X", "type": "number", "min": -1, "max": 1, "step": 0.005, "default": 0 }, "y": { "label": "Posição Y", "type": "number", "min": -1, "max": 1, "step": 0.005, "default": 0 }, "scale": { "label": "Escala", "type": "number", "min": 0.1, "max": 4, "step": 0.01, "default": 1 }, "rotate": { "label": "Rodar (graus)", "type": "number", "min": -180, "max": 180, "step": 0.5, "default": 0 }, "flip": { "label": "Espelhar", "type": "bool", "default": false } } },
  "chroma": { "label": "Chroma key", "group": "compor", "inputs": ["imagem"], "params": { "key": { "label": "Cor a tirar", "type": "color", "default": "#00FF00" }, "similarity": { "label": "Semelhança", "type": "number", "min": 0.01, "max": 1, "step": 0.01, "default": 0.25 }, "blend": { "label": "Suavizar", "type": "number", "min": 0, "max": 1, "step": 0.01, "default": 0.08 } } },
  "blur": { "label": "Desfocar", "group": "efeitos", "inputs": ["imagem"], "params": { "size": { "label": "Quantidade", "type": "number", "min": 0, "max": 1, "step": 0.01, "default": 0.3 } } },
  "glow": { "label": "Brilho", "group": "efeitos", "inputs": ["imagem"], "params": { "amount": { "label": "Intensidade", "type": "number", "min": 0, "max": 1, "step": 0.01, "default": 0.6 }, "size": { "label": "Tamanho", "type": "number", "min": 0.05, "max": 1, "step": 0.01, "default": 0.5 } } },
  "color": { "label": "Cor", "group": "efeitos", "inputs": ["imagem"], "params": { "exposure": { "label": "Exposição", "type": "number", "min": -1, "max": 1, "step": 0.01, "default": 0 }, "contrast": { "label": "Contraste", "type": "number", "min": -1, "max": 1, "step": 0.01, "default": 0 }, "saturation": { "label": "Saturação", "type": "number", "min": -1, "max": 1, "step": 0.01, "default": 0 }, "temperature": { "label": "Temperatura", "type": "number", "min": -1, "max": 1, "step": 0.01, "default": 0 } } },
  "grain": { "label": "Grão de filme", "group": "efeitos", "inputs": ["imagem"], "params": { "amount": { "label": "Quantidade", "type": "number", "min": 0, "max": 1, "step": 0.01, "default": 0.3 } } },
  "letterbox": { "label": "Barras de cinema", "group": "efeitos", "inputs": ["imagem"], "params": { "ratio": { "label": "Proporção", "type": "number", "min": 1, "max": 3, "step": 0.01, "default": 2.39 } } }
}
